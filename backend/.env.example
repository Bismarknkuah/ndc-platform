# --- Django ---
DEBUG=False
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- MongoDB Atlas ---
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=ndc_platform

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- Redis ---
# Either set REDIS_URL directly, or the individual REDISHOST/REDISPORT/
# REDISUSER/REDISPASSWORD components. On Railway, wire this as a
# Reference Variable pointing at the Redis service, not a typed value.
REDIS_URL=redis://redis:6379/0
REDISHOST=redis
REDISPORT=6379
REDISUSER=default
REDISPASSWORD=

# --- CORS ---
# Set CORS_ALLOW_ALL_ORIGINS=True as a temporary escape hatch if you are
# still chasing down the exact origin string for a new deployment. Not
# recommended for a lasting production setup.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend API URL (used by the Next.js app, not this backend) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Superadmin bootstrap (used by seed command) ---
BOOTSTRAP_ADMIN_EMAIL=admin@ndc.example
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# --- External notification delivery (all optional - a channel silently
#     no-ops, logged at INFO, if its section below is left blank) ---
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@ndc-platform.example

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

FCM_SERVER_KEY=

# AI-assisted reporting, the platform chatbot, and the Executive AI
# Assistant all use this same key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Membership dues payment (https://paystack.com, supports Ghana:
# Mobile Money, bank transfer, card, all through one hosted checkout)
PAYSTACK_SECRET_KEY=

# --- Error tracking (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
